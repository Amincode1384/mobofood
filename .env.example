# EnjiNex / Robotic Restaurant — production environment template
# Copy to .env (gitignored) and fill in real values. Never commit real secrets.

# --- Django core (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=restaurant.example.local,10.0.0.10

# TLS behind a reverse proxy: set both once HTTPS is terminated upstream
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
# Enable these two only when every subdomain is HTTPS (irreversible browser cache)
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# --- SQLite location (set to a mounted directory in containers) ---
# DB_NAME=/app/data/db.sqlite3

# --- Signing key for order-tracking tokens (rotating this invalidates old links) ---
ORDER_TRACKING_SECRET=replace-with-a-separate-random-secret

# --- WebSocket / Channel layer ---
# memory = single process only (local dev/tests)
# redis  = required when the Daphne process and timer watcher must share groups
CHANNEL_LAYER_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# --- Robot mission dispatch ---
# memory = simulator (dev/tests); channels = real WebSocket robots
ROBOT_TRANSPORT_BACKEND=channels
ROBOT_API_TOKEN=replace-with-a-long-random-shared-secret
ROBOT_ACK_TIMEOUT_SECONDS=5
ROBOT_DELIVERY_SECONDS=60
